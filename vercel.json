{
  "buildCommand": "cd app && npm install && npm run build",
  "ignoreCommand": "sh \"$(git rev-parse --show-toplevel)/scripts/vercel_lewati_build.sh\"",
  "outputDirectory": "app/dist",
  "crons": [
    { "path": "/api/live-refresh", "schedule": "0 0 * * *" }
  ],
  "rewrites": [
    {
      "source": "/((?!data-idx/|arus-pasar/).*)",
      "destination": "/index.html"
    }
  ]
}
