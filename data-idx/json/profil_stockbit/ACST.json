 Motor Paket 2 New Facility (2022), serta proyek Elevee Penthouse & Residence Fase 1 (2022). Pada tahun 2023, beberapa proyek unggulan yang dikerjakan adalah Data Center di Nongsa Batam, Tol Probolinggo - Banyuwangi, dan Jalan Tol Jakarta - Cikampek II Selatan.","history":{"amount":"375 B","board":"Pemantauan Khusus","date":"24 Jun 2013","price":"2,500","registrar":"","shares":"150,000,000","underwriters":["PT. Kim Eng Securities"],"administrative_bureau":"PT Sinartama Gunita","free_float":"8.83%"},"key_executive":{"commissioner":[{"id":"27563938","key":"Commissioner","lastupdate":"2026-05-06T16:25:14+07:00","value":"IWAN HADIANTORO"},{"id":"27563934","key":"Commissioner","lastupdate":"2026-05-06T16:25:14+07:00","value":"PUTUT EKO BAYUSENO "}],"director":[{"id":"27563942","key":"Director","lastupdate":"2026-05-06T16:25:14+07:00","value":"TJATUR HARIPRIAMBODO"},{"id":"27563941","key":"Director","lastupdate":"2026-05-06T16:25:14+07:00","value":"DAVID WIDJAJA"},{"id":"27563936","key":"Director","lastupdate":"2026-05-06T16:25:14+07:00","value":"SOEHARSONO TJATUR NUGROHO"},{"id":"27563937","key":"Director","lastupdate":"2026-05-06T16:25:14+07:00","value":"HASNANTO WAHYUDI"}],"independent_commissioner":[{"id":"27563939","key":"Commissioner (Independent)","lastupdate":"2026-05-06T16:25:14+07:00","value":"LINDAWATI GANI"},{"id":"27563935","key":"Commissioner (Independent)","lastupdate":"2026-05-06T16:25:14+07:00","value":"BUNTORO MULJONO"}],"president_commissioner":[{"id":"27563943","key":"President Commissioner","lastupdate":"2026-05-06T16:25:14+07:00","value":"VILIHATI SURYA "}],"president_director":[{"id":"27563940","key":"President Director","lastupdate":"2026-05-06T16:25:14+07:00","value":"IDOT SUPRIADI"}],"vice_president":[],"vice_president_commissioner":[],"independent_vice_president_commissioner":[],"independent_president_commissioner":[]},"secretary":[{"id":"12533457","key":"","lastupdate":"2021-12-28T14:02:23+07:00","value":"{\"name\":\"Maria Cesilia Hapsari\",\"p