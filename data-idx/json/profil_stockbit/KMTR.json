, Apollo, dan pedagang internasional, seperti R1 International. Untuk pasar domestik didistribusikan ke pabrik ban Gajah Tunggal sebagai pelanggan utama.","history":{"amount":"528 B","board":"Papan Pengembangan","date":"19 Jun 2017","price":"458","registrar":"","shares":"1,152,450,000","underwriters":["PT. Trimegah Sekuritas Indonesia Tbk"],"administrative_bureau":"PT Adimitra Jasa Korpora","free_float":"7.50%"},"key_executive":{"commissioner":[{"id":"31934431","key":"Commissioner","lastupdate":"2026-06-09T18:30:08+07:00","value":"MARTINUS SUBANDI SINARYA"},{"id":"31934430","key":"Commissioner","lastupdate":"2026-06-09T18:30:08+07:00","value":"FAN, XIAOHONG"},{"id":"31934428","key":"Commissioner","lastupdate":"2026-06-09T18:30:08+07:00","value":"ARIF RACHMAT"},{"id":"31934423","key":"Commissioner","lastupdate":"2026-06-09T18:30:08+07:00","value":"CAI, DUKUN"},{"id":"31934422","key":"Commissioner","lastupdate":"2026-06-09T18:30:08+07:00","value":"LEOW WEI CHANG"}],"director":[{"id":"31934433","key":"Director","lastupdate":"2026-06-09T18:30:08+07:00","value":"HO WAI LEONG"},{"id":"31934432","key":"Director","lastupdate":"2026-06-09T18:30:08+07:00","value":"HENDY ENDARWAN"},{"id":"31934426","key":"Director","lastupdate":"2026-06-09T18:30:08+07:00","value":"FERRY SIDIK"},{"id":"31934425","key":"Director","lastupdate":"2026-06-09T18:30:08+07:00","value":"ACHMAD EFFENDI"}],"independent_commissioner":[{"id":"31934434","key":"Commissioner (Independent)","lastupdate":"2026-06-09T18:30:08+07:00","value":"PROF. DR. IR. HERMANTO SIREGAR, M.EC"},{"id":"31934429","key":"Commissioner (Independent)","lastupdate":"2026-06-09T18:30:08+07:00","value":"ANTONIUS JOENOES SUPIT"},{"id":"31934421","key":"Commissioner (Independent)","lastupdate":"2026-06-09T18:30:08+07:00","value":"DONNY F. TOMASOA"}],"president_commissioner":[{"id":"31934427","key":"President Commissioner","lastupdate":"2026-06-09T18:30:08+07:00","value":"TODDY M. SUGOTO"}],"president_director":[{"id":"31934424","key":"Pre