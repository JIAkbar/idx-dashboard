ia Pasifik.\n\n","history":{"amount":"570 B","board":"Papan Utama","date":"17 Dec 2014","price":"3,800","registrar":"","shares":"150,050,000","underwriters":["PT. Ciptadana Securities"],"administrative_bureau":"PT Sharestar Indonesia","free_float":"21.67%"},"key_executive":{"commissioner":[],"director":[{"id":"32178085","key":"Director","lastupdate":"2026-06-11T15:37:42+07:00","value":"LENGGANA LINGGAWATI"},{"id":"32178084","key":"Director","lastupdate":"2026-06-11T15:37:42+07:00","value":"WIRA YUWANA"},{"id":"32178083","key":"Director","lastupdate":"2026-06-11T15:37:42+07:00","value":"SUGIARTO ROMELI"},{"id":"32178082","key":"Director","lastupdate":"2026-06-11T15:37:42+07:00","value":"JANTO SALIM"},{"id":"32178081","key":"Director","lastupdate":"2026-06-11T15:37:42+07:00","value":"LISAN"},{"id":"32178080","key":"Director","lastupdate":"2026-06-11T15:37:42+07:00","value":"PHILLIP TJIPTO"}],"independent_commissioner":[],"president_commissioner":[],"president_director":[{"id":"32178079","key":"President Director","lastupdate":"2026-06-11T15:37:42+07:00","value":"HARYANTO TJIPTODIHARDJO"}],"vice_president":[],"vice_president_commissioner":[],"independent_vice_president_commissioner":[],"independent_president_commissioner":[]},"secretary":[{"id":"12539046","key":"","lastupdate":"2022-04-11T10:32:20+07:00","value":"{\"name\":\"Lenggana Linggawati\",\"phone\":\"6221-65311045\",\"email\":\"corporate.secretary@impack-pratama.com\"}"}],"shareholder":[{"percentage":"39.74%","name":"PT TUNGGAL JAYA INVESTAMA","value":"21.82 B","badges":[],"id":"0","type":"","location":"","nationality":"","domicile":"","scripless":"","scrip":"","value_formatted":"","classification":""},{"percentage":"36.01%","name":"PT  HARIMAS TUNGGAL PERKASA","value":"19.77 B","badges":[],"id":"0","type":"","location":"","nationality":"","domicile":"","scripless":"","scrip":"","value_formatted":"","classification":""},{"percentage":"22.23%","name":"MASYARAKAT NON WARKAT","value":"12.21 B","badges":[],"id":"0"